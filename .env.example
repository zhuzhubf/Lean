# Hyperliquid connectivity
HL_HYPERLIQUID_BASE_URL=https://api.hyperliquid.xyz
HL_ENVIRONMENT=development
HL_HYPERLIQUID_WALLET=

# Decision + risk settings (versioned profiles)
RISK_PROFILE=moderate_v1
UNIVERSE_PROFILE=universe_v2
CANARY_PROFILE=canary_v1
DAILY_LOSS_LIMIT_PCT=0.10      # Optional override, cannot exceed profile cap
TOTAL_MAX_NOTIONAL_PCT=0.80    # Optional override, cannot exceed profile cap
HL_DECISION_PROVIDER=openai
HL_RUN_INTERVAL=               # Optional override; defaults to risk profile cadence
HL_RUN_ITERATIONS=1
HL_DB_PATH=./trader.db

# LLM providers (default OpenAI-compatible GPT-5.2)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.2
OPENAI_TIMEOUT_SEC=30
OPENAI_MAX_RETRIES=2

# Optional Grok/xAI compatibility (fallback only when explicitly selected)
XAI_API_KEY=
XAI_BASE_URL=
XAI_MODEL=grok-1
XAI_TIMEOUT_SEC=20
XAI_MAX_RETRIES=1

# Live trading guardrails (remain disabled by default)
HL_LIVE_TRADING=false
HL_RISK_ACK=
HL_READONLY_SYMBOLS=BTC,ETH
LIVE_TRADING=false
RISK_ACK=
HL_API_WALLET_CONFIGURED=false
LIVE_ENABLE_TOKEN=
LIVE_ENABLE_TOKEN_PATH=
LIVE_CANARY=false
